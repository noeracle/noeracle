{
  "name": "@noeracle/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Noeracle pull-based price oracle on Stellar",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "demo": "node examples/e2e.mjs",
    "prepublishOnly": "tsc"
  },
  "keywords": ["stellar", "soroban", "oracle", "price-feed", "pull-oracle"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y4hyya/Noeracle.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
